# ── Воронки и этапы ─────────────────────────────────────────────────────
# Заполняется после запуска `npm run discover` (см. README)
# Воронка диспетчера — из неё ловим переход на "Отгрузка"
AMOCRM_DISPATCH_PIPELINE_ID=11207350
AMOCRM_DISPATCH_SHIPPING_STATUS_ID=88140138
# Сюда возвращаем исходную сделку после завершения складом
AMOCRM_DISPATCH_WAYBILL_STATUS_ID=87954430
# Воронка склада — сюда создаём связанную сделку
AMOCRM_SKLAD_PIPELINE_ID=11248530
AMOCRM_SKLAD_NEW_STATUS_ID=88229754
AMOCRM_SKLAD_DONE_STATUS_ID=88229758

# ── ID кастомных полей (общие для всех сделок в amoCRM) ─────────────────
# Читаются из сделки диспетчера и пишутся в сделку склада
AMOCRM_FIELD_SHIP_DATE=1661593
AMOCRM_FIELD_COMPANY=1661587
AMOCRM_FIELD_MATERIAL=1661645
AMOCRM_FIELD_DESCRIPTION=1684517
AMOCRM_FIELD_PLAN_QUANTITY=1661647
AMOCRM_FIELD_ACTUAL_QUANTITY=1662427
# Заполняет зав.склад в веб-инструменте
AMOCRM_FIELD_UNIT_PRICE=1692349
AMOCRM_FIELD_DELIVERY_COST=1692915
AMOCRM_FIELD_PALLET_COUNT=1691001
AMOCRM_FIELD_BUDGET=1691297
# Накладные не требуют отдельных полей: они связываются со сделкой через Files API
# Numeric-поле на складской сделке = ID исходной сделки диспетчера (для отчётов и защиты от дублей)
AMOCRM_FIELD_SOURCE_LEAD=1692369
# Тег, которым помечается сделка диспетчера после создания складской заявки
AMOCRM_PROCESSED_TAG=Склад: заявка создана

# ── Безопасность вебхука ────────────────────────────────────────────────
# Произвольная строка; добавляется в URL вебхука как ?secret=...
AMOCRM_WEBHOOK_SECRET=huiehjbauiHiODHKLldiuwuk

# ── Доступ зав.склада (именные ссылки) ──────────────────────────────────
# Формат: токен1:Имя Фамилия,токен2:Другой Пользователь
# Токены генерируйте случайными: `node -e "console.log(crypto.randomUUID())"`
WAREHOUSE_USERS=0b54d66a-c7fa-49c7-a0bc-20eff60fd4ce:Artur Sarkissyan
WAREHOUSE_DB_PATH=data/warehouse.sqlite

# Базовый адрес приложения (для формирования ссылок в уведомлениях)
APP_BASE_URL=http://localhost:3000
