# ── amoCRM ──────────────────────────────────────────────────────────────
# Поддомен аккаунта: для company.amocrm.ru укажите "company"
# (можно указать и полностью: company.amocrm.ru)
AMOCRM_SUBDOMAIN=company

# Долгосрочный токен доступа (Bearer). Хранится только на сервере.
AMOCRM_ACCESS_TOKEN=

# ── Воронки и этапы ─────────────────────────────────────────────────────
# Заполняется после запуска `npm run discover` (см. README)
# Воронка диспетчера — из неё ловим переход на "Отгрузка"
AMOCRM_DISPATCH_PIPELINE_ID=
AMOCRM_DISPATCH_SHIPPING_STATUS_ID=
# Воронка склада — сюда создаём связанную сделку
AMOCRM_SKLAD_PIPELINE_ID=
AMOCRM_SKLAD_NEW_STATUS_ID=
AMOCRM_SKLAD_DONE_STATUS_ID=

# ── ID кастомных полей (общие для всех сделок в amoCRM) ─────────────────
# Читаются из сделки диспетчера и пишутся в сделку склада
AMOCRM_FIELD_SHIP_DATE=
AMOCRM_FIELD_COMPANY=
AMOCRM_FIELD_QUANTITY=
# Заполняет зав.склад в веб-инструменте
AMOCRM_FIELD_UNIT_PRICE=
AMOCRM_FIELD_DELIVERY_COST=
AMOCRM_FIELD_BUDGET=
AMOCRM_FIELD_WAYBILL=
AMOCRM_FIELD_WAYBILL_PHOTO=
# Numeric-поле на складской сделке = ID исходной сделки диспетчера (для отчётов и защиты от дублей)
AMOCRM_FIELD_SOURCE_LEAD=
# Тег, которым помечается сделка диспетчера после создания складской заявки
AMOCRM_PROCESSED_TAG=Склад: заявка создана

# ── Безопасность вебхука ────────────────────────────────────────────────
# Произвольная строка; добавляется в URL вебхука как ?secret=...
AMOCRM_WEBHOOK_SECRET=change-me

# ── Доступ зав.склада (именные ссылки) ──────────────────────────────────
# Формат: токен1:Имя Фамилия,токен2:Другой Пользователь
# Токены генерируйте случайными: `node -e "console.log(crypto.randomUUID())"`
WAREHOUSE_USERS=

# Базовый адрес приложения (для формирования ссылок в уведомлениях)
APP_BASE_URL=http://localhost:3000
